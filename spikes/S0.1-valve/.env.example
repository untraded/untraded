# Copy to .env (never committed) and fill in.

# Steam Web API key, created from a NON-limited account at https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# The player whose matches we fetch
PLAYER_STEAMID64=
# Match history authentication code: help.steampowered.com → CS2 → match history (format XXXX-XXXXX-XXXX)
PLAYER_AUTH_CODE=
# Most recent Premier share code (format CSGO-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx). Used only on the first run.
PLAYER_INITIAL_SHARE_CODE=

# Bot account (secondary account, NEVER your main one). The password is only used on the
# first run; afterwards a refresh token is stored in .state.json.
BOT_ACCOUNT_NAME=
BOT_PASSWORD=

# Where downloaded demos go (outside the repository)
UNTRADED_CORPUS_DIR=

# Safety limit per run
MAX_MATCHES_PER_RUN=20
